rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (('role' in request.auth.token && request.auth.token.role == 'admin') || 
         ('email' in request.auth.token && (request.auth.token.email == 'shatak1432@gmail.com' || request.auth.token.email.matches('(?i)shatak1432@gmail[.]com'))) ||
         (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // ==========================================
    // 1. BHANDARAS COLLECTION (All casing variants)
    // ==========================================
    match /bhandaras/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    match /Bhandara/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    match /bhandara/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 2. MEMES COLLECTION (Delete, Show/Hide, Edit, Create for Admin)
    // ==========================================
    match /memes/{memeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    match /Memes/{memeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    match /meme/{memeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 3. ADMINS BRIDGE COLLECTION
    // ==========================================
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && 
        request.auth.uid == adminId && 
        (request.resource.data.email == 'shatak1432@gmail.com' || request.resource.data.email.matches('(?i)shatak1432@gmail[.]com')) &&
        request.resource.data.role == 'admin';
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && 
        (request.resource.data.role != 'admin' || 
         request.resource.data.email == 'shatak1432@gmail.com' ||
         request.resource.data.email.matches('(?i)shatak1432@gmail[.]com') ||
         (exists(/databases/$(database)/documents/users/$(userId)) && 
          get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'));
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 6. SAVED BHANDARAS
    // ==========================================
    match /saved_bhandaras/{saveId} {
      allow read, write: if true;
    }

    // ==========================================
    // 7. APP CONFIG
    // ==========================================
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 8. ADMIN LOGS
    // ==========================================
    match /admin_logs/{logId} {
      allow read, write: if true;
    }
  }
}
