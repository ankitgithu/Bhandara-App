rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (('role' in request.auth.token && request.auth.token.role == 'admin') || 
         ('email' in request.auth.token && (request.auth.token.email == 'shatak1432@gmail.com' || request.auth.token.email.matches('(?i)shatak1432@gmail[.]com'))) ||
         (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Bhandaras collection (Supports /bhandaras, /Bhandara, /bhandara)
    match /bhandaras/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /Bhandara/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /bhandara/{bhandaraId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Admins Bridge collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      // Only the verified primary admin can be registered in the admins collection
      allow create, update: if isAuthenticated() && 
        request.auth.uid == adminId && 
        (request.resource.data.email == 'shatak1432@gmail.com' || request.resource.data.email.matches('(?i)shatak1432@gmail[.]com')) &&
        request.resource.data.role == 'admin';
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      // Normal users cannot elevate their role to admin
      allow create, update: if isAuthenticated() && 
        (request.resource.data.role != 'admin' || 
         request.resource.data.email == 'shatak1432@gmail.com' ||
         request.resource.data.email.matches('(?i)shatak1432@gmail[.]com') ||
         (exists(/databases/$(database)/documents/users/$(userId)) && 
          get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'));
      allow delete: if isAdmin();
    }

    // Memes collection (Public Read, ONLY Admin can create, update, or delete)
    match /memes/{memeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reports collection (Users create; Admin reads, updates status, and deletes)
    match /reports/{reportId} {
      allow create: if request.resource.data.bhandaraId is string;
      allow read, update, delete: if isAdmin();
    }

    // Saved Bhandaras collection
    match /saved_bhandaras/{saveId} {
      allow read, write: if true;
    }

    // App Config & Update collection (Public Read, Admin Write)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Logs collection
    match /admin_logs/{logId} {
      allow read, write: if true;
    }
  }
}
